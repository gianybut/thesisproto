<mxfile host="app.diagrams.net"><diagram name="Figure 3.3.1" id="d1"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Input: near-zone crop&lt;br&gt;1920 × 432, plus 24 px of grey&lt;br&gt;above and below (1920 × 480),&lt;br&gt;scaled to 1,024 px (v2b)&lt;br&gt;or 1,280 px (v3, S5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="200" height="130" as="geometry"/></mxCell><mxCell id="c2" value="Backbone (CSPDarknet, C2f)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#F2F2F2;strokeColor=#000000;fontStyle=1;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="260" y="60" width="230" height="400" as="geometry"/></mxCell><mxCell id="c3" value="Conv (P1/2) → Conv (P2/4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="c2"><mxGeometry x="25" y="45" width="180" height="50" as="geometry"/></mxCell><mxCell id="c4" value="C2f → Conv (P3/8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="c2"><mxGeometry x="25" y="115" width="180" height="50" as="geometry"/></mxCell><mxCell id="c5" value="C2f [P3] → Conv (P4/16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="c2"><mxGeometry x="25" y="185" width="180" height="50" as="geometry"/></mxCell><mxCell id="c6" value="C2f [P4] → Conv (P5/32)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="c2"><mxGeometry x="25" y="255" width="180" height="50" as="geometry"/></mxCell><mxCell id="c7" value="C2f → SPPF [P5]" style="rounded=1;whiteSpace=wrap;html=1;fillColo